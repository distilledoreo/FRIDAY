[Unit]
Description=FRIDAY Qwen3.8-Flash-Next via Strata (127.0.0.1:8080)
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=friday-strata
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/friday-strata
Environment=STRATA_BATCH_TRACE=
UMask=0077
WorkingDirectory=%h/AI/Strata
ExecStart=%h/AI/Strata/.venv/bin/python -u serve/server.py --engine strata --config strata-swift-iq3_s.json --host 127.0.0.1 --port 8080 --gpu 0
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=default.target
